# Read by Cloudflare Pages (the primary host) and Netlify as-is. Hosts that cannot set headers (GitHub Pages) still get the CSP
# from the <meta> tag in index.html (added at build time).
# Keep the Content-Security-Policy line identical to CSP in vite.config.ts (tests/web.test.ts checks it).

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self' https://audio.stemdeck.app; connect-src 'self' https://api.github.com; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Cache-Control is set per path without overlaps: hosts that merge matching rules (Cloudflare Pages) would otherwise join
# conflicting values for the same URL.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vite emits content-hashed file names under /assets/: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons, the manifest and the share image are not hashed: a day is enough.
/*.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Prebuilt featured histories (scripts/build-featured.mjs): not hashed, regenerated weekly.
/featured/*
  Cache-Control: public, max-age=3600
